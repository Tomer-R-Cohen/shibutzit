# Copy this file to `.env` (backend, repo root) and fill in the values below.
# The frontend has its own file — see frontend/.env.local (already present).

# ---------------------------------------------------------------------------
# LLM provider (backend/llm/provider.py) — powers the chat / constraint-
# proposal feature only. The rest of the app (loading, validation, solving,
# export) works fully without these; if unset, chat calls fail with a clear
# LLMNotConfiguredError instead of the app crashing.
# ---------------------------------------------------------------------------

# Required to enable the chat/constraint-proposal feature.
LLM_API_KEY=

# Optional — OpenAI-compatible base URL. Defaults to Moonshot's Kimi API.
# LLM_BASE_URL=https://api.moonshot.ai/v1

# Optional — model id. Defaults to "kimi-k2.6".
# LLM_MODEL=kimi-k2.6
