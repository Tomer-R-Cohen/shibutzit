# Backend config. Copy to `.env` and fill in as needed (or export these as
# real environment variables before starting uvicorn) -- python-dotenv is
# not wired in, so these must be actual process env vars.

# Enables the chat/constraint-proposal feature. Without it, chat replies
# with a clear "not configured" error; everything else in the app works.
LLM_API_KEY=

# OpenAI-compatible base URL. Default: Moonshot's Kimi endpoint.
# LLM_BASE_URL=https://api.moonshot.ai/v1

# Model id. Default: kimi-k2.6
# LLM_MODEL=kimi-k2.6

# Comma-separated list of origins allowed to call the API (CORS).
# Default: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
