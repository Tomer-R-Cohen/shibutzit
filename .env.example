# Backend config. Copy to `.env` at the repo root and fill in as needed --
# it's loaded automatically on startup (via python-dotenv). You can also
# export these as real environment variables instead, if you prefer.

# Enables the chat/constraint-proposal feature. Without it, chat replies
# with a clear "not configured" error; everything else in the app works.
LLM_API_KEY=

# OpenAI-compatible base URL. Default (when unset): Moonshot's Kimi
# endpoint. Set to OpenAI's own API to use it instead:
LLM_BASE_URL=https://api.openai.com/v1

# Model id. Cheap and reliable for tool-calling; this feature only ever
# proposes one typed tool call per turn, confirmed by the counselor before
# anything is applied, so a lightweight model is enough.
LLM_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call the API (CORS).
# Default: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
